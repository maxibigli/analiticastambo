# Estado propio de cada instalación (usuarios, sesión, canales de alerta):
# NO se comparte entre PCs, cada servidor tiene el suyo.
usuarios.json
secret_key.txt
alertas_canales.json

# Lecturas del módulo podal (cámaras) y del gateway IoT (lavado/sensores):
# estado propio de cada instalación, no son datos que deban ir al repo.
podal.db
iot_sensores.db

# Scripts y datos de trabajo del backtest del índice de salud (no son parte
# de la app; datos crudos de animales, no deberían quedar en el repo).
_bt_*
# Lista de riesgo transcripta de la pantalla de salud de DelPro, para calibrar
# el índice propio. Mismo criterio que la línea de arriba: son datos crudos de
# animales con su diagnóstico. Se guarda en la instalación, no en el repo.
referencia_chi_delpro.json

# Logs de ejecución
*.log
*.log.err

# Lock de instancia única de servidor.py (ver _tomar_lock_de_instancia_unica).
# Un archivo vacío que existe solo para tomarle el lock exclusivo de Windows;
# no tiene contenido que importe y es propio de cada proceso corriendo.
.servidor.lock

# Números de WhatsApp autorizados a preguntarle a la IA (ver whatsapp_ia.py).
# Estado propio de cada instalación, como alertas_canales.json: quién puede
# preguntar en un tambo no tiene por qué ser lo mismo en otro.
whatsapp_ia_autorizados.json
iot_canales_nombres.json

# Python
__pycache__/
*.pyc
.venv/
venv/
env/

# Editor / SO
.vscode/
.claude/
Thumbs.db
metas_reproductivas.json
parametros_reproductivos.json
conciliacion_grupos.json
clima_cache.json
sala_convencional.json
# Contiene la contraseña de conexión en texto plano (decisión explícita del
# tambo, ver configuracion_tambo.py) — bajo NINGÚN concepto va a git.
configuracion_tambos.json

# Datos genéticos FICTICIOS para probar el cálculo de riesgo por toro (ver
# genetica.py). No va a git para que NUNCA llegue al servidor de producción:
# un riesgo inventado mezclado con los reales podría terminar en una decisión
# de descarte o de servicio. Se regenera cuando se necesite simular.
Padres_del_rodeo_SIMULADO.xlsx

# Precios de los insumos y de la leche (ver precios_alimentos.py). Fuera de git
# por dos motivos: son los PRECIOS DE COMPRA del tambo, información comercial
# propia, y la versión que se genera de arranque trae estimaciones —marcadas,
# pero estimaciones— que no tienen que llegar a producción por un `git pull` y
# terminar en una decisión de plata. Cada instalación tiene la suya, igual que
# `conciliacion_grupos.json`. Por eso mismo la ruta es configurable desde
# ⚙ Configuración: se puede dejar el archivo en una carpeta del tambo.
Precios_alimentos.xlsx

# Límites del Tablero de Diagnóstico. Estado propio de cada instalación, como
# `metas_reproductivas.json`: los umbrales de un tambo no son los de otro, y el
# del servidor de producción no tiene por qué venir de la PC de desarrollo.
tablero_umbrales.json

# Última lectura buena de cada indicador del tablero. Es un caché en disco para
# poder mostrar datos cuando SERVER-DELPRO no está accesible: estado propio de
# cada instalación, con valores del rodeo. No va al repo.
tablero_lecturas.json

# Check-list de control del tambo (ver checklist.py). La base con las cargas
# del operario y las fotos que saca son estado propio de cada instalación,
# igual que `podal.db` o `iot_sensores.db`: no van al repo.
checklist.db
checklist.db-wal
checklist.db-shm
checklist_fotos/

# Bitácora de incidentes y reparaciones (ver bitacora.py). Mismo criterio
# que checklist.db/checklist_fotos: estado propio de cada instalación.
bitacora.db
bitacora.db-wal
bitacora.db-shm
bitacora_fotos/
